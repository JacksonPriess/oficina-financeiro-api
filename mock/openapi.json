    "/pagamentos/{id}/estornos": {
      "post": {
        "summary": "Estornar pagamento aprovado",
        "description": "Somente estorno integral. O status histórico continua APROVADO; estornoId registra a reversão.",
        "tags": [
          "Pagamentos"
        ],
        "security": [
          {
            "ProvedorBearer": []
          }
        ],
        "responses": {
          "200": {
